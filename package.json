{
  "name": "suya-delivery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:apps": "tsc -b && node scripts/build-apps.mjs && node scripts/verify-app-bundles.mjs",
    "build:customer": "tsc -b && node scripts/build-apps.mjs customer && node scripts/verify-app-bundles.mjs customer",
    "build:rider": "tsc -b && node scripts/build-apps.mjs rider && node scripts/verify-app-bundles.mjs rider",
    "build:backoffice": "tsc -b && node scripts/build-apps.mjs backoffice && node scripts/verify-app-bundles.mjs backoffice",
    "build:mobile": "tsc -b && node scripts/build-apps.mjs mobile && node scripts/verify-app-bundles.mjs mobile && npx cap sync",
    "mobile:sync": "npx cap sync",
    "mobile:copy": "npx cap copy",
    "mobile:android": "npm run build:mobile && npx cap open android",
    "mobile:ios": "npm run build:mobile && npx cap open ios",
    "build:pages": "tsc -b && vite build && node scripts/prepare-pages.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:test": "supabase test db --local",
    "db:lint": "supabase db lint --local --level error --fail-on error",
    "lint": "oxlint",
    "security:secrets": "node scripts/check-secrets.mjs",
    "verify:production": "node scripts/verify-production-build.mjs",
    "verify:cloudflare": "node scripts/check-cloudflare-config.mjs",
    "verify:apps": "node scripts/verify-app-bundles.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "node scripts/browser-smoke.mjs",
    "prepare:e2e": "node scripts/prepare-e2e-backend.mjs",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@supabase/supabase-js": "2.112.3",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "2.115.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
