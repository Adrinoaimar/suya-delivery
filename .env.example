# Copia este archivo como .env.local. Todas las variables son opcionales:
# sin ninguna de ellas la demo funciona con el mapa local y sin conexión.

# Proveedor de mapa: mock (por defecto) | leaflet | google
VITE_MAP_PROVIDER=mock

# Necesaria solo si VITE_MAP_PROVIDER=google
# VITE_GOOGLE_MAPS_KEY=
