# Copia este archivo como .env.local. Nunca confirmes valores reales.
# Producción exige backend Supabase; no existe fallback silencioso a mocks.

VITE_BACKEND=supabase
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_EXPECTED_SUPABASE_PROJECT_REF=PROJECT_REF

# URLs independientes: permiten migrar sin cambiar código; Pages hará un redeploy estático.
VITE_CUSTOMER_APP_URL=https://suyadelivery.com
VITE_RIDER_APP_URL=https://rider.suyadelivery.com
VITE_BACKOFFICE_APP_URL=https://panel.suyadelivery.com

# APK nativa: origen HTTPS del manifiesto OTA. Si falta, OTA queda desactivada.
# Producción: https://suyadelivery.com; QA: solo un origen aislado de staging.
# VITE_LIVE_UPDATE_BASE_URL=https://staging.example.com

# Proveedor productivo: osm | google
VITE_MAP_PROVIDER=osm

# Routing vial (OSRM + OpenStreetMap). En producción se recomienda un endpoint propio o con SLA.
# VITE_ROUTING_URL=https://router.project-osrm.org
# VITE_OSM_DARK_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png

# Necesaria solo si VITE_MAP_PROVIDER=google
# VITE_GOOGLE_MAPS_KEY=

# Analítica propia, anónima y opt-in. Es obligatoria para el build productivo.
VITE_ANALYTICS_PROVIDER=suya

# Culqi multipago. Solo activar cuando Supabase tenga CULQI_SECRET_KEY y webhooks configurados.
# VITE_CULQI_GATEWAY_ENABLED=false
# VITE_CULQI_PUBLIC_KEY=pk_test_REPLACE_ME
